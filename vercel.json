{
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "node_modules/better-sqlite3/build/Release/better_sqlite3.node"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.ts"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
