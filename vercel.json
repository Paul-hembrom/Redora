{
  "functions": {
    "api/curriculum/generate": {
      "maxDuration": 900
    },
    "api/index": {
      "maxDuration": 900
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" },
    { "source": "/auth/(.*)", "destination": "/api/index" }
  ],
  "headers": [
    {
      "source": "/auth/token-exchange",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store, no-cache, must-revalidate, proxy-revalidate"
        }
      ]
    }
  ]
}
